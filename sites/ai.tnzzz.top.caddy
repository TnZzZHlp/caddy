# AI 服务 - ai.tnzzz.top
# 类型: 静态前端 + LLM API 流式代理
ai.tnzzz.top {
	tls /etc/caddy/certs/tnzzz.top/fullchain.pem /etc/caddy/certs/tnzzz.top/key.pem

	import security_headers
	import cors_stream

	# API 路由 → 后端
	handle /v1/* {
		reverse_proxy 127.0.0.1:30002 {
			flush_interval -1
			transport http {
				read_timeout 600s
				write_timeout 600s
			}
		}
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:30002 {
			flush_interval -1
			transport http {
				read_timeout 600s
				write_timeout 600s
			}
		}
	}

	# 其余 → 静态文件
	handle {
		root * /www/ai.tnzzz.top
		file_server
	}

	# SPA 兜底
	handle_errors {
		@404 {
			expression {http.error.status_code} == 404
		}
		root * /www/ai.tnzzz.top
		rewrite @404 /index.html
		file_server
	}
}
