# Grafana 监控面板 - grafana.tnzzz.top
# 类型: WebSocket 反向代理
grafana.tnzzz.top {
	tls /etc/caddy/certs/tnzzz.top/fullchain.pem /etc/caddy/certs/tnzzz.top/key.pem

	import security_headers

	reverse_proxy 192.168.2.10:3000 {
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}

	handle_errors {
		@404 {
			expression {http.error.status_code} == 404
		}
		root * /www/grafana.tnzzz.top
		rewrite @404 /index.html
		file_server
	}
}
