# Loki 日志 - loki.tnzzz.top
# 类型: Token 认证反向代理
loki.tnzzz.top {
	tls /etc/caddy/certs/tnzzz.top/fullchain.pem /etc/caddy/certs/tnzzz.top/key.pem

	import security_headers_strict

	@unauthorized {
		not header X-Tnzzzhlp-Authorization "CaYB4Sb6kJOC37aIIPiEtP+ziJe7nP31L94/+zO4G6N+EGmfaN2gaWjeiDBZ1IXckrcSEqkWiwPQjrAF3JT8Tw"
	}
	respond @unauthorized 401

	reverse_proxy 192.168.2.10:3100 {
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}

	handle_errors {
		@404 {
			expression {http.error.status_code} == 404
		}
		root * /www/loki.tnzzz.top
		rewrite @404 /index.html
		file_server
	}
}
