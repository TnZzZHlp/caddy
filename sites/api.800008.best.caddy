# API 网关 - api.800008.best
# 类型: 多后端 API 聚合
api.800008.best {
	tls /etc/caddy/certs/800008.best/fullchain.pem /etc/caddy/certs/800008.best/key.pem

	import security_headers
	import cors

	handle /yuri/* {
		reverse_proxy 127.0.0.1:8081
	}
	handle /ai/* {
		reverse_proxy 127.0.0.1:8081
	}
	handle /ocr {
		reverse_proxy 127.0.0.1:8081
	}

	handle {
		root * /www/api.800008.best
		file_server
	}

	handle_errors {
		@404 {
			expression {http.error.status_code} == 404
		}
		root * /www/api.800008.best
		rewrite @404 /index.html
		file_server
	}
}
