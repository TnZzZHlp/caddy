# MCP 服务 - mcp.tnzzz.top
# 类型: MCP 协议代理（含 mcp-protocol-version 头）
mcp.tnzzz.top {
	tls /etc/caddy/certs/tnzzz.top/fullchain.pem /etc/caddy/certs/tnzzz.top/key.pem

	import security_headers

	header {
		Access-Control-Allow-Origin *
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization, mcp-protocol-version"
	}
	@options {
		method OPTIONS
	}
	respond @options 204

	reverse_proxy 127.0.0.1:30005 {
		flush_interval -1
		transport http {
			read_timeout 600s
			write_timeout 600s
		}
	}

	handle_errors {
		@404 {
			expression {http.error.status_code} == 404
		}
		root * /www/mcp.tnzzz.top
		rewrite @404 /index.html
		file_server
	}
}
