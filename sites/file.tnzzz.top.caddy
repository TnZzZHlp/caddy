# 文件服务 - file.tnzzz.top
# 类型: 大文件上传/下载代理（关闭缓冲）
file.tnzzz.top {
	tls /etc/caddy/certs/tnzzz.top/fullchain.pem /etc/caddy/certs/tnzzz.top/key.pem

	import security_headers

	handle /api/* {
		reverse_proxy 127.0.0.1:30000 {
			flush_interval -1
			transport http {
				read_timeout 600s
				write_timeout 600s
			}
		}
	}

	handle {
		root * /www/file.tnzzz.top
		file_server
	}

	handle_errors {
		@404 {
			expression {http.error.status_code} == 404
		}
		rewrite @404 /index.html
		file_server
	}
}
