# Ryuri 服务 - ryuri.tnzzz.top
# 类型: 内网服务反向代理
ryuri.tnzzz.top {
	tls /etc/caddy/certs/tnzzz.top/fullchain.pem /etc/caddy/certs/tnzzz.top/key.pem

	import security_headers

	reverse_proxy 192.168.255.201:3000 {
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}

	handle_errors {
		@404 {
			expression {http.error.status_code} == 404
		}
		root * /www/ryuri.tnzzz.top
		rewrite @404 /index.html
		file_server
	}
}
