[Unit]
Description=Caddy Web Server
After=network.target network-online.target
Requires=network-online.target

[Service]
Type=notify
User=root
ExecStart=/etc/caddy/bin/caddy run --config /etc/caddy/Caddyfile
ExecReload=/etc/caddy/bin/caddy reload --config /etc/caddy/Caddyfile
ExecStop=/etc/caddy/bin/caddy stop
LimitNOFILE=1048576
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
